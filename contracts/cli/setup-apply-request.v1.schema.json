{
  "$id": "hiroute://contracts/cli/setup-apply-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accept_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "spec": {
      "$ref": "setup-request.v1.schema.json"
    }
  },
  "required": [
    "spec",
    "accept_digest",
    "expected_revision",
    "idempotency_key"
  ],
  "type": "object"
}
