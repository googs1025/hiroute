{
  "$id": "hiroute://contracts/cli/delegation-wait-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "caller": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "grant_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "grant_id": {
          "maxLength": 256,
          "pattern": "^collaboration-grant/",
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "context_id",
        "grant_id",
        "grant_generation"
      ],
      "type": "object"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "wait_ms": {
      "maximum": 30000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "caller",
    "run_id"
  ],
  "type": "object"
}
