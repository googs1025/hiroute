{
  "$id": "hiroute://contracts/cli/operation-cancel-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "operation_id": {
      "pattern": "^op_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "idempotency_key"
  ],
  "type": "object"
}
