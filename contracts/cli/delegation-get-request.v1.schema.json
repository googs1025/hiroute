{
  "$id": "hiroute://contracts/cli/delegation-get-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "submission_key"
            ]
          },
          {
            "required": [
              "submission_operation"
            ]
          }
        ]
      },
      "required": [
        "task_id"
      ]
    },
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "task_id"
            ]
          },
          {
            "required": [
              "run_id"
            ]
          }
        ]
      },
      "required": [
        "submission_key",
        "submission_operation"
      ]
    }
  ],
  "properties": {
    "caller": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "grant_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "grant_id": {
          "maxLength": 256,
          "pattern": "^collaboration-grant/",
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "context_id",
        "grant_id",
        "grant_generation"
      ],
      "type": "object"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "submission_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "submission_operation": {
      "enum": [
        "start",
        "continue"
      ]
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "caller"
  ],
  "type": "object"
}
