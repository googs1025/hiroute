{
  "$id": "hiroute://contracts/cli/delegation-cancel-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caller": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "grant_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "grant_id": {
          "maxLength": 256,
          "pattern": "^collaboration-grant/",
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "context_id",
        "grant_id",
        "grant_generation"
      ],
      "type": "object"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_./:-]*$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "caller",
    "run_id",
    "idempotency_key"
  ],
  "type": "object"
}
