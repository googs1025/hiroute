      "request": {
        "model": "hiroute-pool",
        "max_tokens": 64,
        "stream": true,
        "messages": [
          {
            "role": "user",
            "content": "请实现并调试一个高并发网关状态机，重点处理性能、安全和竞态问题。"
          },
          {
            "role": "assistant",
