      "request": {
        "model": "hiroute-pool",
        "stream": true,
        "prompt_cache_key": "hiroute-e2e-complex-turn",
        "input": [
          {
            "type": "message",
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "请实现并调试这个并发状态机，同时分析性能和安全问题。"
              }
            ]
          }
        ]
      },
      "attempts": [
        { "source": "codex-chatgpt", "response_head_status": 200 }
      ],
      "expected_source": "codex-chatgpt",
      "expected_class": "complex",
      "expected_affinity": "new_turn"
    },
    {
      "id": "responses-large-agent-envelope-still-simple",
      "protocol": "responses",
      "request": {
        "model": "hiroute-pool",
        "stream": true,
        "instructions": "你是一个负责大型代码库实现、调试、并发、状态机、性能和安全分析的 Coding Agent。工具说明和系统规则不代表当前用户任务的复杂度，路由器必须只判断最后一个真实用户指令。",
        "tools": [
          {
            "type": "function",
            "name": "read_file",
            "description": "读取任意大型源码文件，用于实现、调试、重构、并发、性能、安全、架构和多文件分析。",
            "parameters": {
              "type": "object",
              "properties": {
                "path": { "type": "string" }
              },
              "required": ["path"]
            }
          }
        ],
        "input": [
          {
            "type": "message",
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "2+2 等于多少？"
              }
            ]
          }
        ]
      },
      "attempts": [
        { "source": "claude-compatible", "response_head_status": 200 }
      ],
      "expected_source": "claude-compatible",
      "expected_class": "simple",
      "expected_affinity": "new_turn"
    },
    {
      "id": "messages-simple-to-claude",
      "protocol": "messages",
      "request": {
        "model": "hiroute-pool",
        "max_tokens": 64,
        "stream": true,
        "messages": [
          {
            "role": "user",
            "content": "用一句话解释 HTTP。"
