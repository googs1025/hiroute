{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiroute.dev/e2e/current-production-launcher.schema.json",
  "title": "HiRoute production hirouted launcher evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "executable_path",
    "executable_sha256",
    "sut_source_revision",
    "build_attestation",
    "child_pid",
    "listen_address",
    "arguments",
    "environment",
    "publication_digest",
    "credential_manifest_digest",
    "credential_lease_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "hiroute.e2e.production-launcher/v2"
    },
    "mode": {
      "const": "production_publication_credentials"
    },
    "executable_path": {
      "type": "string",
      "minLength": 1
    },
    "executable_sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "sut_source_revision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40
    },
    "build_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_revision",
        "sealed_source_tree",
        "build_input_digest",
        "source_checkout",
        "cargo_package",
        "cargo_binary",
        "cargo_profile",
        "enabled_features",
        "target_triple",
        "cargo_version",
        "rustc_version",
        "rustc_wrapper",
        "rustc_wrapper_version",
        "toolchain_digest",
        "build_nonce",
        "build_command",
        "executable_path",
        "executable_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "hiroute.e2e.sut-build-attestation/v3"
        },
        "source_revision": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "sealed_source_tree": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "build_input_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        },
        "source_checkout": {
          "type": "string",
          "minLength": 1
        },
        "cargo_package": {
          "const": "hiroute-gateway"
        },
        "cargo_binary": {
          "const": "hirouted"
        },
        "cargo_profile": {
          "const": "dev"
        },
        "enabled_features": {
          "const": [
            "all"
          ]
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "cargo_version": {
          "type": "string",
          "minLength": 1
        },
        "rustc_version": {
          "type": "string",
          "minLength": 1
        },
        "rustc_wrapper": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rustc_wrapper_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "toolchain_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        },
        "build_nonce": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "build_command": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executable_path": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        }
      }
    },
    "child_pid": {
      "type": "integer",
      "minimum": 1
    },
    "listen_address": {
      "type": "string",
      "minLength": 10
    },
    "arguments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "HIROUTE_E2E_OBSERVATION_CAPTURE",
        "HIROUTE_OBSERVATION_DIRECTORY",
        "HIROUTE_OBSERVATION_QUEUE_BYTES",
        "HIROUTE_OBSERVATION_LIFECYCLE_SINK",
        "HIROUTE_OBSERVATION_EXECUTION_SINK",
        "HIROUTE_OBSERVATION_CONTENT_SINK",
        "HIROUTE_OBSERVATION_OTEL_SINK",
        "HIROUTE_LAUNCHER_EXECUTABLE_SHA256",
        "HIROUTE_E2E_DIAL_CONFIG"
      ],
      "properties": {
        "HIROUTE_E2E_OBSERVATION_CAPTURE": {
          "const": "1"
        },
        "HIROUTE_OBSERVATION_DIRECTORY": {
          "type": "string",
          "minLength": 1
        },
        "HIROUTE_OBSERVATION_QUEUE_BYTES": {
          "const": "4194304"
        },
        "HIROUTE_OBSERVATION_LIFECYCLE_SINK": {
          "const": "healthy"
        },
        "HIROUTE_OBSERVATION_EXECUTION_SINK": {
          "const": "healthy"
        },
        "HIROUTE_OBSERVATION_CONTENT_SINK": {
          "const": "healthy"
        },
        "HIROUTE_OBSERVATION_OTEL_SINK": {
          "const": "healthy"
        },
        "HIROUTE_LAUNCHER_EXECUTABLE_SHA256": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "HIROUTE_E2E_DIAL_CONFIG": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "credential_manifest_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "credential_lease_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    }
  }
}
