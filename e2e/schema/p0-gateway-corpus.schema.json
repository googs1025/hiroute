{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiroute.dev/e2e/p0-gateway-corpus.schema.json",
  "title": "HiRoute P0 native protocol corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle_version", "privacy_markers", "cases"],
  "properties": {
    "schema_version": {"const": "hiroute.e2e.corpus/v1"},
    "oracle_version": {"const": "p0-gateway-oracle-v1"},
    "privacy_markers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
    "cases": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "grant_access", "ingress", "providers"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "grant_access": {"enum": ["allowed", "denied"]},
          "ingress": {
            "type": "object", "additionalProperties": false,
            "required": ["protocol", "path", "authorization", "body"],
            "properties": {
              "protocol": {"enum": ["responses", "chat_completions", "messages"]},
              "path": {"enum": ["/v1/responses", "/v1/chat/completions", "/v1/messages"]},
              "authorization": {"enum": ["missing", "invalid", "valid"]},
              "body": {"type": "object", "minProperties": 1}
            }
          },
          "providers": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "protocol", "expected_calls", "expected_request", "response"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "protocol": {"enum": ["responses", "chat_completions", "messages"]},
                "expected_calls": {"type": "integer", "minimum": 0},
                "expected_request": {"type": "object", "minProperties": 2},
                "response": {"type": "object", "minProperties": 3}
              }
            }
          }
        }
      }
    }
  }
}
